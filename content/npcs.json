  "propagation": [
    {
      "id": "PR_LINH_TIP_CAPTIVE",
      "kind": "assert",
      "from": "linh",
      "to": "thach",
      "at": 8,
      "once": true,
      "_doc": "Captive run only. In the operator run the same note is delivered through the player (EV_O_D3N_LINH_TIP). Linh deflects from Đức by naming the stranger, unless she trusts the newcomer and saw nothing suspicious.",
      "when": {
        "op": "and",
        "args": [
          {
            "op": "role",
            "is": "captive"
          },
          {
            "op": "flag",
            "flag": "linh.reportsToThach",
            "equals": true
          },
          {
            "op": "or",
            "args": [
              {
                "op": "trust",
                "npc": "linh",
                "cmp": "<",
                "value": 2
              },
              {
                "op": "npcKnowsTag",
                "npc": "linh",
                "tag": "T_C_COVERED_DUC_SEARCH"
              }
            ]
          }
        ]
      },
      "factId": "F_CAPTIVE_PC_NEAR_ADMIN_D3",
      "believedValue": true,
      "misinformation": true,
      "also": [
        {
          "type": "flag",
          "flag": "thach.hasCaptiveTip",
          "value": true
        }
      ],
      "priority": 10
    },
    {
      "id": "PR_LINH_RELAY_CAPTIVE_TAGS",
      "kind": "relay",
      "from": "linh",
      "to": "thach",
      "delay": 1,
      "when": {
        "op": "flag",
        "flag": "linh.reportsToThach",
        "equals": true
      },
      "tags": [
        "T_C_COVERED_DUC_SEARCH",
        "T_C_CONFRONTED_LINH",
        "T_C_SPOKE_FOR_DUC"
      ],
      "priority": 20
    },
    {
      "id": "PR_DUC_CONFIDES_LINH",
      "kind": "relay",
      "from": "duc",
      "to": "linh",
      "delay": 0,
      "once": true,
      "_doc": "D4 afternoon: Đức tells Linh where 'it' is — unless the captive warned him about her.",
      "when": {
        "op": "and",
        "args": [
          {
            "op": "segment",
            "cmp": ">=",
            "value": 10
          },
          {
            "op": "npcStatus",
            "npc": "duc",
            "is": "present"
          },
          {
            "op": "not",
            "arg": {
              "op": "npcKnowsTag",
              "npc": "duc",
              "tag": "T_C_WARNED_DUC_ABOUT_LINH"
            }
          },
          {
            "op": "flag",
            "flag": "phone.location",
            "equals": "dorm_ceiling"
          }
        ]
      },
      "facts": [
        "F_PHONE_EXISTS",
        "F_PHONE_TAKEN_BY_DUC",
        "F_PHONE_HIDDEN_DORM_CEILING"
      ],
      "priority": 30
    },
    {
      "id": "PR_LINH_RELAY_LOCATION",
      "kind": "relay",
      "from": "linh",
      "to": "thach",
      "delay": 1,
      "_doc": "Linh reports the LOCATION, not the thief — 'chuyện nhỏ'. Thạch draws his own (wrong) conclusion in R_THACH_RAID_CEILING.",
      "when": {
        "op": "flag",
        "flag": "linh.reportsToThach",
        "equals": true
      },
      "facts": [
        "F_PHONE_HIDDEN_DORM_CEILING"
      ],
      "priority": 40
    },
    {
      "id": "PR_LINH_DOUBLE_AGENT_FEED",
      "kind": "assert",
      "from": "linh",
      "to": "thach",
      "at": 16,
      "once": true,
      "_doc": "If the captive turned Linh (D6 afternoon), that same evening she tells Thạch the newcomer never had the phone (true — she OBSERVED it) and withdraws her old tip: Thạch relaxes his watch before the D6 escape window (audit F-15 fix).",
      "when": {
        "op": "flag",
        "flag": "linh.doubleAgent",
        "equals": true
      },
      "factId": "F_PHONE_TAKEN_BY_CAPTIVE_PC",
      "believedValue": false,
      "also": [
        {
          "type": "flag",
          "flag": "thach.hasCaptiveTip",
          "value": false
        },
        {
          "type": "stat",
          "stat": "suspicion",
          "delta": -15
        }
      ],
      "priority": 50
    },
    {
      "id": "PR_VU_REPORTS_PHONE",
      "kind": "assert",
      "from": "vu",
      "to": "thach",
      "at": 14,
      "once": true,
      "_doc": "Vũ sits on the phone for a day, then hands it up — unless someone gave him a reason not to.",
      "when": {
        "op": "and",
        "args": [
          {
            "op": "flag",
            "flag": "phone.location",
            "equals": "vu_locker"
          },
          {
            "op": "not",
            "arg": {
              "op": "and",
              "args": [
                {
                  "op": "role",
                  "is": "operator"
                },
                {
                  "op": "tag",
                  "tag": "T_O_TOLD_VU_HIDE"
                }
              ]
            }
          },
          {
            "op": "not",
            "arg": {
              "op": "and",
              "args": [
                {
                  "op": "role",
                  "is": "captive"
                },
                {
                  "op": "trust",
                  "npc": "vu",
                  "cmp": ">=",
                  "value": 2
                }
              ]
            }
          }
        ]
      },
      "factId": "F_PHONE_HIDDEN_DORM_CEILING",
      "believedValue": true,
      "also": [
        {
          "type": "flag",
          "flag": "phone.location",
          "value": "thach"
        }
      ],
      "priority": 60
    },
    {
      "id": "PR_THACH_TELLS_VU_SCAPEGOAT",
      "kind": "relay",
      "from": "thach",
      "to": "vu",
      "delay": 0,
      "once": true,
      "when": {
        "op": "flag",
        "flag": "duc.scapegoated",
        "equals": true
      },
      "facts": [
        "F_DUC_IS_THE_LEAK"
      ],
      "priority": 70
    },
    {
      "id": "PR_THACH_TELLS_VU_TRANSFER",
      "kind": "assert",
      "from": "thach",
      "to": "vu",
      "at": 18,
      "once": true,
      "when": {
        "op": "always"
      },
      "factId": "F_TRANSFER_DAY7",
      "believedValue": true,
      "priority": 80,
      "_doc": "Night 6: Thạch tells Vũ about the transfer. If a raid is coming the game ends at D7 morning before this matters; no world-only flag is read (closes the Phase 3 visibility exception)."
    }
  ]
